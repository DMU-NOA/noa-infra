# ======================================================
# 예정 output 목록 (모듈 구현 완료 시 순차적으로 추가)
# ======================================================

# S3
# output "frontend_bucket_id"  — 프론트엔드 정적 파일 버킷 ID
# output "frontend_bucket_arn" — 프론트엔드 정적 파일 버킷 ARN

# CloudFront
# output "cloudfront_distribution_id"         — CloudFront 배포 ID
# output "cloudfront_distribution_domain_name" — CloudFront 도메인명 (배포 후 DNS 연결용)

# ACM
# output "acm_certificate_arn" — CloudFront 연결용 ACM 인증서 ARN (us-east-1)

# Route53
# output "route53_zone_id" — 도메인 호스팅 존 ID
