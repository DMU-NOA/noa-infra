prometheus.exporter.unix "node" { }

prometheus.scrape "node" {
  targets    = prometheus.exporter.unix.node.targets
  forward_to = [prometheus.remote_write.grafana.receiver]
}

%{ if scrape_app ~}
prometheus.scrape "app" {
  targets      = [{"__address__" = "localhost:${app_metrics_port}"}]
  metrics_path = "${app_metrics_path}"
  forward_to   = [prometheus.remote_write.grafana.receiver]
}
%{ endif ~}

local.file_match "app_logs" {
  path_targets = [{"__path__" = "${app_log_dir}/*.log", "job" = "${service}"}]
}

loki.source.file "app_logs" {
  targets    = local.file_match.app_logs.targets
  forward_to = [loki.write.grafana.receiver]
}

prometheus.remote_write "grafana" {
  external_labels = {
    service = "${service}",
    env     = "${env}",
  }
  endpoint {
    url = sys.env("GC_PROM_URL")
    basic_auth {
      username = sys.env("GC_PROM_USER")
      password = sys.env("GC_API_TOKEN")
    }
  }
}

loki.write "grafana" {
  external_labels = {
    service = "${service}",
    env     = "${env}",
  }
  endpoint {
    url = sys.env("GC_LOKI_URL")
    basic_auth {
      username = sys.env("GC_LOKI_USER")
      password = sys.env("GC_API_TOKEN")
    }
  }
}